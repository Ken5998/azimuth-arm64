From 3f4eb4d5752aca0dd498810f32f865b231a7dfc9 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Kenan=20Kasumovi=C4=87?=
 <46025606+Ken5998@users.noreply.github.com>
Date: Tue, 20 Oct 2026 16:08:08 +0000
Subject: [PATCH 2/2] ir3: lower leftover fmulz/ffmaz/fmadz before the backend

nir_opt_algebraic_late lowers fmulz and friends with the abs-min
pattern, but nir_opt_algebraic in ir3_context_init turns that pattern
back into fmulz, and its single late pass can fuse an fmadz it does not
revisit. emit_alu has no case for these, so compiling some of Forza
Horizon 2's shaders under Azimuth crashed with "Unhandled ALU op: fmadz".

Lower whatever is left right after the last algebraic pass.
---
 src/freedreno/ir3/ir3_context.c |  6 +++++
 src/freedreno/ir3/ir3_nir.c     | 39 +++++++++++++++++++++++++++++++++
 src/freedreno/ir3/ir3_nir.h     |  1 +
 3 files changed, 46 insertions(+)

diff --git a/src/freedreno/ir3/ir3_context.c b/src/freedreno/ir3/ir3_context.c
index 1d6acf2..318bded 100644
--- a/src/freedreno/ir3/ir3_context.c
+++ b/src/freedreno/ir3/ir3_context.c
@@ -99,6 +99,12 @@ ir3_context_init(struct ir3_compiler *compiler, struct ir3_shader *shader,
       NIR_PASS(progress, ctx->s, nir_opt_dce);
    }
 
+   /* No nir_opt_algebraic may run after this, it would re-form fmulz. */
+   bool fmulz_progress = false;
+   NIR_PASS(fmulz_progress, ctx->s, ir3_nir_lower_fmulz);
+   if (fmulz_progress)
+      NIR_PASS(_, ctx->s, nir_opt_dce);
+
    /* This must run after the last nir_opt_algebraic or it gets undone. */
    if (compiler->has_branch_and_or)
       NIR_PASS(_, ctx->s, ir3_nir_opt_branch_and_or_not);
diff --git a/src/freedreno/ir3/ir3_nir.c b/src/freedreno/ir3/ir3_nir.c
index 4e1961f..8bc7c60 100644
--- a/src/freedreno/ir3/ir3_nir.c
+++ b/src/freedreno/ir3/ir3_nir.c
@@ -534,6 +534,45 @@ ir3_nir_lower_array_sampler(nir_shader *shader)
       nir_metadata_control_flow, NULL);
 }
 
+/* nir_opt_algebraic_late lowers fmulz/ffmaz/fmadz with the abs-min pattern,
+ * but nir_opt_algebraic turns that pattern back into fmulz and a single late
+ * pass can fuse it into an fmadz it doesn't revisit. emit_alu has no case for
+ * these, so lower whatever is left right before the backend.
+ */
+static bool
+ir3_nir_lower_fmulz_cb(nir_builder *b, nir_alu_instr *alu, void *data)
+{
+   if (alu->op != nir_op_fmulz && alu->op != nir_op_ffmaz &&
+       alu->op != nir_op_fmadz)
+      return false;
+
+   b->cursor = nir_before_instr(&alu->instr);
+
+   nir_def *x = nir_ssa_for_alu_src(b, alu, 0);
+   nir_def *y = nir_ssa_for_alu_src(b, alu, 1);
+   nir_def *is_zero =
+      nir_feq_imm(b, nir_fmin(b, nir_fabs(b, x), nir_fabs(b, y)), 0.0);
+
+   nir_def *res;
+   if (alu->op == nir_op_fmulz) {
+      res = nir_bcsel(b, is_zero, nir_imm_floatN_t(b, 0.0, x->bit_size),
+                      nir_fmul(b, x, y));
+   } else {
+      nir_def *z = nir_ssa_for_alu_src(b, alu, 2);
+      res = nir_bcsel(b, is_zero, z, nir_fmad(b, x, y, z));
+   }
+
+   nir_def_replace(&alu->def, res);
+   return true;
+}
+
+bool
+ir3_nir_lower_fmulz(nir_shader *shader)
+{
+   return nir_shader_alu_pass(shader, ir3_nir_lower_fmulz_cb,
+                              nir_metadata_control_flow, NULL);
+}
+
 /* pack_uvec2_to_uint does clamping that we don't need to do. */
 static nir_def *
 pack_16_16(nir_builder *b, nir_def *x)
diff --git a/src/freedreno/ir3/ir3_nir.h b/src/freedreno/ir3/ir3_nir.h
index 4e9cff9..4a8b3ff 100644
--- a/src/freedreno/ir3/ir3_nir.h
+++ b/src/freedreno/ir3/ir3_nir.h
@@ -19,6 +19,7 @@ BEGINC;
 
 bool ir3_nir_apply_trig_workarounds(nir_shader *shader);
 bool ir3_nir_lower_imul(nir_shader *shader);
+bool ir3_nir_lower_fmulz(nir_shader *shader);
 bool ir3_nir_lower_io_offsets(nir_shader *shader, struct ir3_compiler *c);
 bool ir3_nir_lower_load_sample_pos(nir_shader *shader);
 bool ir3_nir_lower_load_barycentric_at_offset(nir_shader *shader);
